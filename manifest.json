{
   "manifest_version": 3,
   "name": "HackerNewsDark",
   "description": "A nice, readable, dark theme for Hacker News.",
   "version": "0.11.3",
   "icons": {
      "128": "icons/128.png",
      "16": "icons/16.png",
      "48": "icons/48.png"
   },
   "permissions": [],
   "host_permissions": [
      "*://news.ycombinator.com/*"
   ],
   "content_scripts": [ {
      "css": [ "css/style.css" ],
      "js": [ "js/main.js" ],
      "matches": [ "*://news.ycombinator.com/*" ],
      "run_at": "document_end"
   } ],
  "web_accessible_resources": [
    {
      "resources": [ "css/style.css" ],
      "matches": [ "*://news.ycombinator.com/*" ]
    }
  ]
}
